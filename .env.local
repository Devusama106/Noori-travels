# Optional: live flight search (real airlines, real-time prices) via Amadeus for Developers.
# Sign up free at https://developers.amadeus.com, create an app under "Self-Service APIs",
# and paste your test API Key/Secret below. Leave blank to run with only your own listings —
# the app works fully without these, live search is purely additive.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Optional: email notifications for the registration/approval workflow (new agency registers →
# admins get emailed → approved/rejected agency gets emailed). Leave blank to run without email —
# the app works fully without these; messages are simply logged to this server's console instead.
# Example values for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<a 16-character Gmail "App Password", not your normal password>.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=usamaumar106@gmail.com    
